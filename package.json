{
  "name": "shadcn-landing-page",
  "version": "0.1.0",
  "description": "Modern bilingual landing page starter with SSR i18n, persistent themes, and editable shadcn/ui sections.",
  "private": true,
  "license": "MIT",
  "author": "LvvUP",
  "keywords": [
    "landing-page",
    "nextjs",
    "react",
    "shadcn-ui",
    "tailwindcss",
    "typescript",
    "i18n",
    "next-intl"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LvvUP/shadcn-landing-page.git"
  },
  "bugs": {
    "url": "https://github.com/LvvUP/shadcn-landing-page/issues"
  },
  "homepage": "https://github.com/LvvUP/shadcn-landing-page#readme",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "check": "npm run check:i18n && npm run check:dependencies && npm run lint && npm run typecheck && npm run build",
    "audit": "npm audit --audit-level=high"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "@swc/helpers": "0.5.23",
    "postcss": "$postcss"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.34.0",
    "next": "^16.3.3",
    "next-intl": "^4.13.7",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^10.9.0",
    "eslint-config-next": "^16.3.3",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3"
  }
}
